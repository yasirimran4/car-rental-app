@model List<Car>

<html>
<head>
    <title>Car Rental</title>
</head>
<body>
<h2>Available Cars</h2>
<p>Click on Book button in front of any car to book it.</p>
<div class="container">
    <div class="row">
        @foreach (var car in Model)
        {
            <div class="card col-md-6 col-lg-4 p-2 my-2">
                <div class="card-body">
                    <div class="card-title fs-2 fw-bold">
                        @car.Name 
                    </div>
                </div>
                <div class="badge text-bg-success">
                    Available
                </div>
                <p class="card-text">
                    Rent per day : @car.PricePerDay PKR
                    </p>
                <form method="post" asp-action="Book" asp-controller="Cars">
                        <input type="hidden" name="Id" value="@car.Id"/>
                        <button type="submit" class="btn btn-primary w-100">Book Card</button>
                        </form>
            </div> 
        }
    </div>
</div>
</body>
</html>