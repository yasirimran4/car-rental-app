@model List<Car>

<html>
<head>
    <title>Car Rental</title>
</head>
<body>
<h2>Booked Cars</h2>
@if (Model.Count == 0)
{
    <h2 class="text-center">No booked car</h2>
}
else
{
    <table class="table table-striped">
        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price Per Day</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.PricePerDay</td>
                <td class="badge w-100 text-bg-warning text-dark ">Booked</td>
            </tr>
        }
        </tbody>
    </table>
}

</body>
</html>